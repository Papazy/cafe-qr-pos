{
    "name": "warkop-qr/ordering-system",
    "description": "Warkop QR Code Ordering System - PHP Native",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "endroid/qr-code": "^4.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "WarkopQR\\": "includes/"
        },
        "files": [
            "includes/config.php",
            "includes/database.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!file_exists('.env')) { copy('.env.example', '.env'); echo '.env file created\n'; }\""
        ],
        "seed": [
            "@php database/seed.php"
        ],
        "serve": [
            "@php -S localhost:8000"
        ]
    }
}
